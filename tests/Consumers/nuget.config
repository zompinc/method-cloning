<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="packed" value="../../artifacts/package/release" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="packed">
      <package pattern="Zomp.MethodCloning" />
      <package pattern="Zomp.MethodCloning.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
