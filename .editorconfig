root = true

[*]
end_of_line = crlf
indent_style = space
indent_size = 2
insert_final_newline = true

# Xml project files
[*.{csproj,props,targets,slnx}]
indent_size = 2

# C# files
[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped
csharp_style_expression_bodied_methods = true:silent
csharp_style_expression_bodied_operators = true
csharp_style_expression_bodied_local_functions = true
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1633.severity = none
# https://github.com/DotNetAnalyzers/StyleCopAnalyzers/issues/3540
dotnet_diagnostic.SA1118.severity = none
# SA1005: Single line comments should begin with single space
dotnet_diagnostic.SA1005.severity = none
# This helps visibility sometimes
dotnet_diagnostic.IDE0046.severity = suggestion

# The package ships these sources marked <auto-generated/>, so that the analyzers of the
# generator which compiles them leave them alone. They are analyzed here instead.
[src/Zomp.MethodCloning/**.cs]
generated_code = false
# Generated code defaults to nullable disabled, so each file enables it for its consumers.
dotnet_diagnostic.IDE0240.severity = none
# The generated-code marker opens every file, which StyleCop reads as a file header.
dotnet_diagnostic.SA1634.severity = none

[tests/**.cs]
# CS1591: Missing XML comment for publicly visible type or member
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.SA1600.severity = none
# SA1512: Single-line comments should not be followed by blank line
dotnet_diagnostic.SA1512.severity = none
